# =============================================================================
# CasaRespuestos API — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the NestJS server listens on
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database — individual vars (used by TypeORM config object)
# -----------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=casarespuestos_dev
DB_USER=casarespuestos
DB_PASSWORD=your-database-password-here

# -----------------------------------------------------------------------------
# Database — connection string (alternative; can be used instead of individual vars)
# TypeORM accepts either style. Individual vars are preferred for Railway deploys
# where DATABASE_URL is injected automatically.
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# -----------------------------------------------------------------------------
# JWT — Access Token
# Short-lived token sent with every API request (Authorization: Bearer <token>)
# -----------------------------------------------------------------------------

JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m

# -----------------------------------------------------------------------------
# JWT — Refresh Token
# Long-lived token used to obtain a new access token when it expires.
# Must be different from the access secret.
# -----------------------------------------------------------------------------

JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins.
# Example: https://casarespuestos.vercel.app,https://staging.casarespuestos.vercel.app
# -----------------------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Bcrypt
# Cost factor for password hashing. 10–12 is a sensible range.
# Higher = slower hash (more secure but more CPU).
# -----------------------------------------------------------------------------

BCRYPT_ROUNDS=10

# -----------------------------------------------------------------------------
# Dataico — electronic invoicing API
# Auth is a custom header, not Bearer/OAuth: every request sends
# `Auth-token: <DATAICO_AUTH_TOKEN>`. Get the real token from the Dataico
# account this store invoices under — never commit a real value here.
# -----------------------------------------------------------------------------

DATAICO_BASE_URL=https://api.dataico.com/direct/dataico_api/v2
DATAICO_AUTH_TOKEN=replace-with-the-real-dataico-auth-token
DATAICO_ACCOUNT_ID=replace-with-the-real-dataico-account-id

# Master switches for what Dataico does with a created document. Both OFF by default:
# the document is created in Dataico but NOT submitted to the DIAN / NOT emailed to the customer.
# Only the word \"true\" turns one on. Applies to invoices, credit/debit notes, resends and payroll.
DATAICO_SEND_DIAN=false
DATAICO_SEND_EMAIL=false

# Invoice numbering is auto-incremented locally (see InvoicesService) —
# the next number is the highest of (last local number + 1) and this
# value. It seeds the store's real DIAN-facing sequence, which already
# has history from before this app existed, and can be raised at any time
# to jump the local count ahead (e.g. when invoices were issued outside
# this app on the same Dataico account). Lowering it has no effect once
# local invoices exist past it.
INVOICE_NUMBER_START=1

# Nota débito / nota crédito. Unlike invoices, both use Dataico's
# flexible numbering — no DIAN resolution_number, just this store's own
# prefix per note type. Required: a wrong or missing prefix would produce
# an invalid legal document, so there's no fallback default the way
# there is for INVOICE_NUMBER_START.
DATAICO_DEBIT_NOTE_PREFIX=replace-with-the-real-debit-note-prefix
DEBIT_NOTE_NUMBER_START=1
DATAICO_CREDIT_NOTE_PREFIX=replace-with-the-real-credit-note-prefix
CREDIT_NOTE_NUMBER_START=1

# Nómina Electrónica (Phase 15) lives on the same host as standard
# invoicing but a different API path (payroll-api, not dataico_api).
DATAICO_PAYROLL_BASE_URL=https://api.dataico.com/direct/payroll-api/v2

# -----------------------------------------------------------------------------
# Seed — first admin user (npm run seed:admin)
# Only used by the seed script; change the password after first login.
# -----------------------------------------------------------------------------

SEED_ADMIN_EMAIL=admin@casarespuestos.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
